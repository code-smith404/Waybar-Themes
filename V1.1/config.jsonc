{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 3,
  "margin": "2px 4px 0",
  "fixed-center": true,
  "modules-left": [
    "custom/tag-1",
    "custom/tag-2",
    "custom/tag-3",
    "custom/tag-4",
    "custom/tag-5",
    "clock"
  ],
  "modules-center": [
    "custom/window-title"
  ],
  "modules-right": [
    "pulseaudio",
    "memory",
    "cpu",
    "custom/brightness"
  ],
  "custom/tag-1": {
    "exec": "$HOME/.config/waybar/scripts/mango-tags 1",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1,
    "on-click": "mmsg dispatch view,1 >/dev/null",
    "on-click-right": "mmsg dispatch toggleview,1 >/dev/null"
  },
  "custom/tag-2": {
    "exec": "$HOME/.config/waybar/scripts/mango-tags 2",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1,
    "on-click": "mmsg dispatch view,2 >/dev/null",
    "on-click-right": "mmsg dispatch toggleview,2 >/dev/null"
  },
  "custom/tag-3": {
    "exec": "$HOME/.config/waybar/scripts/mango-tags 3",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1,
    "on-click": "mmsg dispatch view,3 >/dev/null",
    "on-click-right": "mmsg dispatch toggleview,3 >/dev/null"
  },
  "custom/tag-4": {
    "exec": "$HOME/.config/waybar/scripts/mango-tags 4",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1,
    "on-click": "mmsg dispatch view,4 >/dev/null",
    "on-click-right": "mmsg dispatch toggleview,4 >/dev/null"
  },
  "custom/tag-5": {
    "exec": "$HOME/.config/waybar/scripts/mango-tags 5",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1,
    "on-click": "mmsg dispatch view,5 >/dev/null",
    "on-click-right": "mmsg dispatch toggleview,5 >/dev/null"
  },
  "custom/window-title": {
    "exec": "$HOME/.config/waybar/scripts/mango-title",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 1,
    "max-length": 48
  },
  "custom/brightness": {
    "exec": "$HOME/.config/waybar/scripts/brightness-control status",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "interval": 30,
    "on-click": "$HOME/.config/waybar/scripts/brightness-control cycle",
    "on-scroll-up": "$HOME/.config/waybar/scripts/brightness-control up",
    "on-scroll-down": "$HOME/.config/waybar/scripts/brightness-control down"
  },
  "clock": {
    "format": " {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": "󰖁 muted",
    "scroll-step": 5,
    "tooltip-format": "{desc}: {volume}%"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
    "tooltip-format": "RAM: {used} / {total}"
  },
  "cpu": {
    "interval": 3,
    "format": "󰻠 {usage}%",
    "tooltip-format": "CPU: {usage}%"
  }
}
